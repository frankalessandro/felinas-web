---
import Layout from "../layouts/Layout.astro";
import WhatsAppButton from "../components/shared/WhatsAppButton.astro";
import SiteNav from "../components/shared/SiteNav.astro";
import ShowHero from "../components/fproductions/ShowHero.astro";
import ManifestoSection from "../components/fproductions/ManifestoSection.astro";
import ReelsSection from "../components/fproductions/ReelsSection.astro";
import TeamSection from "../components/fproductions/TeamSection.astro";
import ServicesSection from "../components/fproductions/ServicesSection.astro";
import GallerySection from "../components/fproductions/GallerySection.astro";
import WhyUsSection from "../components/fproductions/WhyUsSection.astro";
import ProcessSection from "../components/fproductions/ProcessSection.astro";
import BookingCTA from "../components/fproductions/BookingCTA.astro";
import SiteFooter from "../components/shared/SiteFooter.astro";
import LoadingScreen from "../components/shared/LoadingScreen.astro";
---

<Layout
  title="Felinas F Productions — Shows en vivo y eventos"
  description="F Productions es el grupo de shows en vivo de Felinas. Contrata shows de baile, videos musicales, animación de eventos y modelaje para marcas en discotecas, eventos privados y activaciones."
>
  <LoadingScreen />
  <div class="min-h-screen bg-[#07030b] text-[#f8f5fa] font-sans antialiased selection:bg-felina-morado/40">
    <SiteNav side="show" />
    <main>
      <ShowHero />
      <ManifestoSection />
      <ReelsSection />
      <TeamSection />
      <ServicesSection />
      <GallerySection />
      <WhyUsSection />
      <ProcessSection />
      <BookingCTA />
    </main>
    <SiteFooter side="show" />
    <WhatsAppButton />
  </div>
</Layout>

<script>
  // Orquestador único de animaciones de la página (evita timelines/listeners duplicados)
  import {
    initReveals,
    initParallaxX,
    initHorizontalScrollSections,
    initAmbient,
    initScrollActive,
    initScrollSpotlight,
    initRevolverSection,
    ScrollTrigger,
  } from "../scripts/animations";
  import { initReels } from "../scripts/reels";
  import { revealPage } from "../scripts/loader";

  // initReveals() oculta los [data-reveal] YA (gsap.set, sin medir layout): tiene
  // que pasar antes del primer paint o el usuario ve el contenido visible un frame
  // y saltar a oculto al siguiente, que cuenta como layout shift real. Lo caro de
  // esa función —crear un ScrollTrigger por elemento, que sí mide layout— se
  // devuelve como función y se ejecuta más abajo, ya diferido.
  const wireReveals = initReveals();

  // revealPage() también va temprano: solo arma promesas (fonts.ready + decode de
  // las imágenes eager), así que es barata y no depende de lo de abajo.
  revealPage();

  // Todo esto crea ScrollTriggers para CADA sección de la página — gallería,
  // equipo, reels, servicios— y cada uno mide el layout real de sus elementos
  // (forced reflow). Si corriera antes del primer paint, bloquearía el hilo
  // principal entero con trabajo de secciones que el usuario tarda varios
  // segundos en alcanzar. Un rAF alcanza para dejar pintar primero: nadie
  // scrollea más rápido que un frame, así que diferir esto es imperceptible.
  requestAnimationFrame(() => {
    wireReveals();
    initParallaxX();
    initAmbient();
    initScrollActive();
    initScrollSpotlight("#services-list");

    // Los pines (Reels, Equipo, Galería) van en el mismo orden en que aparecen en
    // el documento. Cada uno mide "dónde empieza" con getBoundingClientRect, y esa
    // medida incluye el pin-spacer de todo lo que esté ANTES en el DOM: si Galería
    // se creara antes que Reels/Equipo, mediría la página sin los ~3000px que esos
    // pines todavía no agregaron, y terminaría pinneándose de más — encimada con
    // la sección anterior, que sigue pinneada cuando Galería ya debería activarse.
    initReels();
    initRevolverSection();
    initHorizontalScrollSections();

    // Red de seguridad: por si algo (fuentes, imágenes) todavía mueve el layout
    // después de crear los pines de arriba, se vuelve a medir todo una vez más.
    ScrollTrigger.refresh();
  });
</script>
