---
import Layout from "../layouts/Layout.astro";
import LandingSplitScreen from "../components/shared/LandingSplitScreen.astro";
import LoadingScreen from "../components/shared/LoadingScreen.astro";
import andreaImg from "../assets/academia/Andrea_NoBg_11zon.webp";
import maeImg from "../assets/fproductions/Mae_NoBg_11zon.webp";
---

<Layout title="Felinas — Elige tu lado">
  <LoadingScreen />
  <LandingSplitScreen andreaSrc={andreaImg.src} maeSrc={maeImg.src} />
</Layout>

<style is:global>
  html, body {
    overflow: hidden !important;
    height: 100%;
    background: #000;
  }
</style>

<script>
  import { hideLoader } from "../scripts/animations";
  window.addEventListener("load", () => hideLoader("loading-screen", 0.4));
</script>
