---
import Layout from "../layouts/Layout.astro";
import LandingDiagonal from "../components/shared/LandingDiagonal.astro";
import LoadingScreen from "../components/shared/LoadingScreen.astro";
---

<Layout title="Felinas — Elige tu lado">
  <LoadingScreen />
  <LandingDiagonal />
</Layout>

<style is:global>
  html, body {
    overflow: hidden !important;
    height: 100%;
    background: #000;
  }
</style>

<script>
  import { hideLoader } from "../scripts/animations";
  window.addEventListener("load", () => hideLoader("loading-screen", 0.4));
</script>
