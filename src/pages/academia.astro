---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/shared/Navbar.astro";
import AboutSection from "../components/academia/AboutSection.astro";
import StatsSection from "../components/academia/StatsSection.astro";
import ClassesSection from "../components/academia/ClassesSection.astro";
import MembershipSection from "../components/academia/MembershipSection.astro";
import FAQSection from "../components/academia/FAQSection.astro";
import CTASection from "../components/academia/CTASection.astro";
import Footer from "../components/shared/Footer.astro";
import WhatsAppButton from "../components/shared/WhatsAppButton.astro";
import HeroSpotlight from "../components/academia/HeroSpotlight.astro";
import LoadingScreen from "../components/shared/LoadingScreen.astro";
import maeHeroImg from "../assets/academia/mae-hero.webp";
import panterHeroImg from "../assets/academia/panter-hero.webp";
---

<Layout title="Felinas Academia — Danza Urbana">
  <LoadingScreen />
  <div class="min-h-screen bg-black">
    <Navbar />
    <main>
      <HeroSpotlight bg1={maeHeroImg.src} bg2={panterHeroImg.src} />
      <AboutSection />
      <StatsSection />
      <ClassesSection />
      <MembershipSection />
      <FAQSection />
      <CTASection />
    </main>
    <Footer />
    <WhatsAppButton />
  </div>
</Layout>

<script>
  // Orquestador único de la página: todas las timelines se registran acá.
  import { initReveals, initSlideReveals, initCounters, initAmbient } from "../scripts/animations";
  import { revealPage } from "../scripts/loader";

  initReveals();
  initSlideReveals();
  initCounters();
  initAmbient();

  revealPage();
</script>
