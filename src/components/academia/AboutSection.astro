---
import { Image } from "astro:assets";
import comunidad1 from "../../assets/academia/Comunidad1.webp";
import comunidad2 from "../../assets/academia/Comunidad2.webp";
import comunidad3 from "../../assets/academia/Comunidad3.jpeg.webp";

const values = [
  { label: "Empoderamiento femenino", icon: "sparkles" },
  { label: "Autoconfianza sin límites", icon: "heart" },
  { label: "Conexión con tu cuerpo", icon: "music" },
  { label: "Comunidad auténtica", icon: "users" },
];

const communityImages = [comunidad1, comunidad2, comunidad3];
---

<section id="comunidad-section" class="py-24 md:py-32 bg-background relative overflow-hidden">
  <div class="absolute bottom-0 right-0 w-[500px] h-[500px] bg-primary/10 rounded-full blur-[100px] translate-y-1/2 translate-x-1/3"></div>
  <div class="absolute top-10 right-10 opacity-[0.03] pointer-events-none select-none">
    <h2 class="font-display font-black text-[10rem] md:text-[15rem] leading-[0.8]">ABOUT<br />US</h2>
  </div>

  <div data-reveal class="container px-4 relative z-10">
    <div class="flex flex-col lg:flex-row items-center gap-16 lg:gap-24">

      <div class="w-full lg:w-1/2 relative min-h-[420px] sm:min-h-[500px] md:min-h-[600px] flex items-center justify-center pt-6 pb-4">
        <div class="absolute inset-0 bg-secondary/5 rounded-full blur-3xl"></div>
        <div id="comunidad-carousel" class="w-[92%] sm:w-[85%] aspect-[4/5] md:aspect-square relative z-20">
          <div class="absolute inset-0 bg-secondary rounded-[2rem] sm:rounded-[3rem] md:rounded-[5rem] rounded-tr-[4rem] sm:rounded-tr-[6rem] md:rounded-tr-[15rem] overflow-hidden border border-border/50 shadow-2xl">
            <div class="absolute inset-0 bg-gradient-to-tr from-primary/20 to-transparent mix-blend-overlay pointer-events-none z-10"></div>

            <div class="relative w-full h-full">
              {communityImages.map((img, i) => (
                <div
                  data-slide
                  class:list={["absolute inset-0 transition-opacity duration-700 ease-in-out", i === 0 ? "opacity-100" : "opacity-0"]}
                >
                  <Image
                    src={img}
                    alt={`Comunidad Felinas ${i + 1}`}
                    class="w-full h-full object-cover"
                    widths={[400, 800]}
                    sizes="(max-width: 768px) 85vw, 40vw"
                    loading="lazy"
                  />
                </div>
              ))}
            </div>

            <div class="absolute bottom-4 left-1/2 -translate-x-1/2 z-20 flex gap-2">
              {communityImages.map((_, i) => (
                <span
                  data-dot
                  class:list={["w-1.5 h-1.5 rounded-full transition-all duration-300", i === 0 ? "bg-primary w-4" : "bg-background/70"]}
                ></span>
              ))}
            </div>
          </div>

          <button
            type="button"
            data-carousel-prev
            aria-label="Imagen anterior"
            class="absolute left-0 -translate-x-1/2 top-1/2 -translate-y-1/2 z-30 w-7 h-7 rounded-full bg-background/70 backdrop-blur-sm border border-border/40 flex items-center justify-center text-foreground/50 opacity-70 hover:opacity-100 hover:text-primary hover:bg-background/95 transition-all duration-300"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
          </button>
          <button
            type="button"
            data-carousel-next
            aria-label="Siguiente imagen"
            class="absolute right-0 translate-x-1/2 top-1/2 -translate-y-1/2 z-30 w-7 h-7 rounded-full bg-background/70 backdrop-blur-sm border border-border/40 flex items-center justify-center text-foreground/50 opacity-70 hover:opacity-100 hover:text-primary hover:bg-background/95 transition-all duration-300"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
          </button>
        </div>
        <div class="absolute bottom-0 left-0 sm:-bottom-2 sm:-left-4 md:bottom-4 md:left-4 bg-background border border-border p-3 sm:p-4 md:p-6 rounded-2xl shadow-xl z-30 animate-bounce-subtle">
          <p class="font-display font-black text-2xl sm:text-4xl md:text-5xl text-foreground">
            100<span class="text-primary">%</span>
          </p>
          <p class="text-[10px] sm:text-xs uppercase tracking-widest text-muted-foreground mt-1 font-bold">Actitud Felina</p>
        </div>
        <div class="absolute top-0 right-10 w-32 h-32 rounded-full border border-primary/30 pointer-events-none scale-150 -z-10"></div>
      </div>

      <div class="w-full lg:w-1/2 relative">
        <div class="w-24 h-1 bg-primary mb-8"></div>
        <p class="font-display font-semibold text-primary text-sm tracking-[0.4em] uppercase mb-4">Nuestra esencia</p>
        <h2 class="font-display font-black text-5xl md:text-6xl leading-[1] mb-8">
          <span class="text-foreground">MÁS QUE UNA</span><br />
          <span class="text-transparent text-stroke-secondary text-stroke-2">ACADEMIA,</span><br />
          <span class="text-gradient-pink italic pr-4"> UNA COMUNIDAD</span>
        </h2>
        <p class="text-lg md:text-xl text-muted-foreground leading-relaxed mb-10 font-light max-w-lg">
          Felinas nació con la idea de crear un espacio donde las personas puedan expresarse con libertad, fortalecer su confianza y descubrir nuevas formas de conectar a través de la danza. 
          Un lugar donde cada proceso es bienvenido, sin importar la experiencia o el nivel.
        </p>

        <div class="flex flex-col gap-6 relative">
          <div class="absolute left-[19px] top-6 bottom-6 w-px bg-border -z-10"></div>
          {values.map((v) => (
            <div class="flex items-center gap-6 group">
              <div class="w-10 h-10 rounded-full bg-background border border-primary/30 flex items-center justify-center shrink-0 group-hover:bg-primary group-hover:border-primary transition-colors duration-300 shadow-sm">
                {v.icon === "sparkles" && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary group-hover:text-white transition-colors">
                    <path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"/>
                  </svg>
                )}
                {v.icon === "heart" && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary group-hover:text-white transition-colors">
                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                  </svg>
                )}
                {v.icon === "music" && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary group-hover:text-white transition-colors">
                    <path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/>
                  </svg>
                )}
                {v.icon === "users" && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary group-hover:text-white transition-colors">
                    <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                  </svg>
                )}
              </div>
              <span class="text-base md:text-lg font-medium text-foreground group-hover:text-primary transition-colors cursor-default">
                {v.label}
              </span>
            </div>
          ))}
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  const el = document.querySelector("[data-reveal]") as HTMLElement | null;
  if (el) {
    el.style.opacity = "0";
    el.style.transform = "translateY(30px)";
    el.style.transition = "opacity 0.6s ease-out, transform 0.6s ease-out";
    const obs = new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting) {
        el.style.opacity = "1";
        el.style.transform = "translateY(0)";
        obs.unobserve(el);
      }
    }, { threshold: 0.15 });
    obs.observe(el);
  }

  const carousel = document.querySelector("#comunidad-carousel");
  if (carousel) {
    const slides = Array.from(carousel.querySelectorAll<HTMLElement>("[data-slide]"));
    const dots = Array.from(carousel.querySelectorAll<HTMLElement>("[data-dot]"));
    let current = 0;
    let timer: ReturnType<typeof setInterval>;

    const goTo = (index: number) => {
      slides[current].classList.replace("opacity-100", "opacity-0");
      dots[current].classList.replace("bg-primary", "bg-background/70");
      dots[current].classList.replace("w-4", "w-1.5");

      current = (index + slides.length) % slides.length;

      slides[current].classList.replace("opacity-0", "opacity-100");
      dots[current].classList.replace("bg-background/70", "bg-primary");
      dots[current].classList.replace("w-1.5", "w-4");
    };

    const next = () => goTo(current + 1);
    const prev = () => goTo(current - 1);

    const startAutoplay = () => {
      timer = setInterval(next, 5000);
    };
    const stopAutoplay = () => clearInterval(timer);

    carousel.querySelector("[data-carousel-next]")?.addEventListener("click", () => {
      next();
      stopAutoplay();
      startAutoplay();
    });
    carousel.querySelector("[data-carousel-prev]")?.addEventListener("click", () => {
      prev();
      stopAutoplay();
      startAutoplay();
    });
    dots.forEach((dot, i) => {
      dot.addEventListener("click", () => {
        goTo(i);
        stopAutoplay();
        startAutoplay();
      });
    });

    carousel.addEventListener("mouseenter", stopAutoplay);
    carousel.addEventListener("mouseleave", startAutoplay);

    if (slides.length > 1) startAutoplay();
  }
</script>
