---
const stats = [
  { value: 9, suffix: "+", label: "Años de experiencia" },
  { value: 80, suffix: "%", label: "Enfoque personalizado" },
  { value: 5, suffix: "", label: "Estilos de danza" },
  { value: 5, suffix: "", label: "Clases semanales" },
];
---

<section class="py-20 md:py-32 bg-background border-y border-border overflow-hidden relative">
  <div class="absolute top-1/2 left-1/4 w-96 h-96 bg-primary/5 rounded-full blur-[100px] -translate-y-1/2 -z-10"></div>
  <div class="container px-4">
    <div class="flex flex-col md:flex-row flex-wrap justify-between items-center gap-16 md:gap-8">
      {stats.map((s) => (
        <div data-reveal class="flex flex-col items-center md:items-start relative group">
          <div class="relative inline-block">
            <p
              data-counter={s.value}
              data-suffix={s.suffix}
              class="font-display font-black text-6xl md:text-8xl lg:text-[8rem] text-transparent text-stroke-primary text-stroke-2 leading-none"
            >
              {s.value}{s.suffix}
            </p>
          </div>
          <div class="absolute -bottom-4 left-0 w-0 h-0.5 bg-primary group-hover:w-full transition-all duration-500 hidden md:block"></div>
          <p class="mt-4 text-base md:text-lg text-foreground font-medium uppercase tracking-widest pl-2 border-l-2 border-primary/50">
            {s.label}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
