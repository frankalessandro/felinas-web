---
// Paleta neutra a propósito: tinta, crema y champagne metálico. El rosa de marca queda
// solo como un detalle (el sufijo y la barra), para que los datos destaquen sin gritar.
type Stat = {
  value: number;
  suffix: string;
  label: string;
  // Posición/tamaño en la grilla de escritorio (12 columnas)
  cell: string;
  tone: "champagne" | "cream" | "ink";
  bar?: boolean;
};

const stats: Stat[] = [
  { value: 9, suffix: "+", label: "Años de experiencia", cell: "md:col-span-5 md:row-span-2", tone: "champagne" },
  { value: 80, suffix: "%", label: "Enfoque personalizado", cell: "md:col-span-7", tone: "cream", bar: true },
  { value: 5, suffix: "", label: "Estilos de danza", cell: "md:col-span-4", tone: "ink" },
  { value: 5, suffix: "", label: "Clases semanales", cell: "md:col-span-3", tone: "cream" },
];
---

<section class="py-20 md:py-32 bg-background border-y border-border overflow-hidden relative">
  <div class="container px-4">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-5">
      {stats.map((s) => (
        <div data-reveal class:list={["stat relative overflow-hidden rounded-3xl p-7 md:p-10 flex flex-col justify-end", `stat-${s.tone}`, s.cell]}>
          <div class:list={[s.tone === "champagne" ? "md:pt-40" : "md:pt-10"]}>
            <p class:list={["font-display font-black tracking-tighter leading-[0.85] flex items-start", s.tone === "champagne" ? "stat-num-xl" : "stat-num"]}>
              <span data-counter={s.value} data-suffix="">{s.value}</span>
              {s.suffix && <span class="stat-suffix">{s.suffix}</span>}
            </p>
            <p class="stat-label mt-4 text-xs md:text-sm font-bold uppercase tracking-[0.22em]">{s.label}</p>
            {s.bar && (
              <div class="stat-bar mt-6 h-1.5 rounded-full overflow-hidden">
                <div class="h-full w-full bg-primary origin-left rounded-full" style={`transform: scaleX(${s.value / 100})`}></div>
              </div>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .stat-num { font-size: clamp(4.5rem, 9vw, 7.5rem); }
  .stat-num-xl { font-size: clamp(7rem, 15vw, 13rem); }
  .stat-suffix { font-size: 0.45em; margin: 0.12em 0 0 0.06em; color: #ff006a; }

  /* Champagne metálico: bandas suaves de luz y sombra sobre un beige cálido */
  .stat-champagne {
    background: linear-gradient(135deg, #f6efe3 0%, #dccfb8 38%, #f3ead9 55%, #cdbda1 100%);
    color: #231b12;
  }
  .stat-champagne .stat-label { color: rgb(35 27 18 / 0.75); }

  .stat-cream {
    background: #f7f2ea;
    border: 1px solid #e9dfd0;
    color: #1c1814;
  }
  .stat-cream .stat-label { color: rgb(28 24 20 / 0.65); }
  .stat-bar { background: #e6dccb; }

  /* Rosado empolvado: el único toque de color de marca, suave */
  .stat-ink {
    background: linear-gradient(135deg, #f9e3ea 0%, #f2cfdb 100%);
    color: #2a1420;
  }
  .stat-ink .stat-label { color: rgb(42 20 32 / 0.7); }
</style>
