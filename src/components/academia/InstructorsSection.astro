---
import { Image } from "astro:assets";
import maeImg from "../../assets/academia/clase-twerk-avanzado.webp";
import andreaImg from "../../assets/academia/clase-flex.webp";
import hipHopImg from "../../assets/academia/clase-hip-hop.webp";
import breakingImg from "../../assets/academia/clase-breaking.webp";

type Instructor = {
  name: string;
  classes: string[];
  social: string;
  handle: string;
  image: ImageMetadata;
};

const instructors: Instructor[] = [
  { name: "Mae", classes: ["Twerk Recreativo", "Twerk Avanzado"], social: "https://www.instagram.com/mae.aleja", handle: "@mae.aleja", image: maeImg },
  { name: "Angélica", classes: ["Urbano"], social: "https://www.instagram.com/angee.ortizg", handle: "@angee.ortizg", image: hipHopImg },
  { name: "Jahn Evels", classes: ["Breaking"], social: "https://www.instagram.com/bboyevelss", handle: "@bboyevelss", image: breakingImg },
  { name: "Andrea Altamirano", classes: ["Flex", "Yoga", "Gimnasia"], social: "https://www.instagram.com/andrealtamirano_", handle: "@andrealtamirano_", image: andreaImg },
];
---

<section id="instructores" class="relative py-24 md:py-36 bg-secondary text-white overflow-hidden">
  <div class="absolute -top-24 left-1/4 w-[520px] h-[520px] rounded-full bg-primary/15 blur-[130px] pointer-events-none"></div>
  <div class="absolute bottom-0 right-0 w-[420px] h-[420px] rounded-full bg-felina-morado/20 blur-[120px] pointer-events-none"></div>

  <div class="container px-4 relative z-10">
    <div data-reveal class="max-w-3xl mb-16 md:mb-24">
      <h2 class="text-white">
        <span class="title-eyebrow">Quienes te guían</span>
        <span class="title-main" style="font-size: clamp(1.8rem, 8.6vw, 5.5rem);">TUS <span class="title-accent">INSTRUCTORES</span></span>
      </h2>
      <p class="mt-6 text-white/60 text-base md:text-lg leading-relaxed font-light">
        Bailarines y entrenadores en activo. Cada clase la dicta quien vive ese estilo, en grupos de máximo 6 personas.
      </p>
    </div>

    <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-6 gap-y-14">
      {instructors.map((p, i) => (
        <li data-reveal class:list={["instructor group", i % 2 === 1 && "lg:mt-14"]}>
          <a href={p.social} target="_blank" rel="noopener noreferrer" aria-label={`${p.name} en Instagram`} class="block">
            <div class="relative aspect-[3/4] overflow-hidden rounded-2xl bg-white/5">
              <Image
                src={p.image}
                alt={p.name}
                widths={[360, 560, 800]}
                sizes="(max-width: 640px) 90vw, (max-width: 1024px) 45vw, 22vw"
                loading="lazy"
                class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                style="object-position: 50% 30%"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/10 to-transparent"></div>
              <span class="absolute top-4 left-4 font-display font-black text-sm tracking-[0.2em] text-primary">{String(i + 1).padStart(2, "0")}</span>
              <span class="instructor-ig absolute top-3 right-3 w-9 h-9 rounded-full bg-white/10 backdrop-blur-md flex items-center justify-center text-white" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" /></svg>
              </span>
              <div class="absolute inset-x-0 bottom-0 p-5">
                <p class="font-display font-black uppercase text-2xl md:text-3xl leading-[0.95] tracking-tight">{p.name}</p>
                <p class="mt-1 text-xs text-white/50 tracking-widest">{p.handle}</p>
              </div>
            </div>
            <ul class="mt-4 flex flex-wrap gap-2">
              {p.classes.map((c) => (
                <li class="text-[11px] font-bold uppercase tracking-[0.15em] px-3 py-1 rounded-full border border-primary/40 text-primary">{c}</li>
              ))}
            </ul>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .instructor-ig {
    opacity: 0;
    transform: translateY(-6px);
    transition: opacity 0.3s, transform 0.3s;
  }
  .instructor:hover .instructor-ig,
  .instructor a:focus-visible .instructor-ig {
    opacity: 1;
    transform: none;
  }
  /* Sin hover (táctil) el icono queda siempre visible: es la pista de que es un enlace */
  @media (hover: none) {
    .instructor-ig {
      opacity: 1;
      transform: none;
    }
  }
</style>
