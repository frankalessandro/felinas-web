---
interface Props {
  bg1: string;
  bg2: string;
}
const { bg1, bg2 } = Astro.props;

const WA = "https://wa.me/573203426558?text=%C2%A1Hola!%20Quiero%20agendar%20mi%20clase%20en%20Felinas";
const CELL = 48;

const imgStyle = [
  "position:absolute",
  "bottom:0",
  "left:50%",
  "transform:translateX(-50%)",
  "height:100%",
  "width:auto",
  "max-width:none",
  "pointer-events:none",
  "object-fit:contain",
  "object-position:bottom center",
  "filter:drop-shadow(0 24px 60px rgba(0,0,0,0.14)) drop-shadow(-8px 0 30px rgba(0,0,0,0.06)) drop-shadow(8px 0 30px rgba(0,0,0,0.06)) drop-shadow(0 0 50px rgba(233,30,140,0.18))",
].join(";");
---

<section id="inicio" class="relative min-h-screen flex items-center overflow-hidden bg-background">
  <!-- Grid parallax -->
  <div class="absolute inset-0 z-[1] pointer-events-none" style="opacity: 0.13;">
    <svg width="100%" height="100%">
      <defs>
        <pattern id="hgrid" width={CELL} height={CELL} patternUnits="userSpaceOnUse" x="0" y="0">
          <path d={`M ${CELL} 0 L 0 0 0 ${CELL}`} fill="none" stroke="#e91e8c" stroke-width="0.7"></path>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#hgrid)"></rect>
    </svg>
  </div>

  <!-- Ambient glows -->
  <div
    class="absolute top-0 right-0 w-[800px] h-[800px] rounded-full -translate-y-1/2 translate-x-1/2 pointer-events-none z-[1]"
    style="background: hsl(340 82% 52% / 0.10); filter: blur(120px);"
  ></div>
  <div
    class="absolute bottom-0 left-0 w-[600px] h-[600px] rounded-full translate-y-1/2 -translate-x-1/3 pointer-events-none z-[1]"
    style="background: hsl(300 100% 27% / 0.08); filter: blur(100px);"
  ></div>

  <!-- DANCE ghost text -->
  <div class="absolute top-1/4 -right-20 md:right-10 opacity-[0.09] pointer-events-none select-none z-[2] overflow-hidden">
    <h2 class="font-display font-black leading-[0.8]" style="font-size: clamp(10rem, 20vw, 25rem); color: transparent; -webkit-text-stroke: 2px hsl(340 82% 52%);">
      DANCE
    </h2>
  </div>

  <div class="container relative z-[10] px-4 py-20 lg:py-0 w-full">
    <div class="flex flex-col lg:flex-row items-center justify-between gap-12 lg:gap-8">
      <!-- Left column — text content -->
      <div class="w-full lg:w-1/2">
        <p data-hero-fade class="font-display font-semibold text-primary text-sm md:text-base tracking-[0.4em] uppercase mb-6 border-l-2 border-primary pl-4">
          COMUNIDAD DE DANZA Y MOVIMIENTO
        </p>

        <h1
          data-hero-fade
          class="font-display font-black tracking-tight leading-[0.9] mb-8 flex flex-col"
          style="font-size: clamp(3.5rem, 8vw, 6.5rem);"
        >
          <span class="uppercase text-foreground">Descubre</span>
          <span class="uppercase text-transparent" style="-webkit-text-stroke: 2px hsl(0 0% 4%);">TU FELINA</span>
          <span class="text-gradient-pink italic pr-4">INTERIOR</span>
        </h1>

        <p
          data-hero-fade
          class="text-lg md:text-xl max-w-md mb-10 font-light border-l-2 border-primary/30 pl-4"
          style="color: hsl(var(--muted-foreground));"
        >
          Felinas es una comunidad donde la danza se convierte en una herramienta para aprender, expresarse, conectar y crecer.
          Un espacio para descubrir tu movimiento, desarrollar tu confianza y crear conexiones auténticas.
        </p>

        <div data-hero-fade class="flex flex-col sm:flex-row gap-6">
          <a
            href={WA}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 bg-primary hover:bg-felina-rosa-glow text-white font-display font-bold rounded-full px-8 py-4 text-base transition-all hover:scale-105 hover:shadow-[0_0_28px_hsl(340_82%_52%/0.5)] group"
          >
            AGENDA TU CLASE
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:translate-x-1 transition-transform">
              <path d="M5 12h14M12 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Right column — spotlight image area -->
      <div id="hero-image-area" data-hero-fade class="w-full lg:w-1/2 relative h-[500px] md:h-[600px] lg:h-[700px] overflow-hidden">
        <!-- Image wrapper — la máscara desvanece todos los bordes -->
        <div
          class="absolute inset-0"
          style="
            -webkit-mask-image: linear-gradient(to right, transparent 0%, black 12%, black 85%, transparent 100%), linear-gradient(to bottom, transparent 0%, black 12%, black 82%, transparent 100%);
            mask-image: linear-gradient(to right, transparent 0%, black 12%, black 85%, transparent 100%), linear-gradient(to bottom, transparent 0%, black 12%, black 82%, transparent 100%);
            -webkit-mask-composite: destination-in;
            mask-composite: intersect;
          "
        >
          <!-- Imagen base (MaeHero) -->
          <img src={bg1} alt="" style={imgStyle} />

          <!-- Revelado spotlight (PanterHero) -->
          <div id="hero-reveal" class="absolute inset-0 pointer-events-none">
            <img src={bg2} alt="" style={imgStyle} />
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-10 left-8 md:left-14 z-50 animate-bounce-subtle flex flex-col items-center gap-2">
    <span
      class="text-[10px] uppercase font-bold tracking-widest font-display"
      style="color: hsl(var(--muted-foreground)); writing-mode: vertical-rl;"
    >
      SCROLL
    </span>
    <button
      id="hero-scroll-btn"
      aria-label="Scroll down"
      class="w-8 h-8 rounded-full border flex items-center justify-center transition-colors hover:bg-pink-500/10 hover:border-pink-500/50"
      style="border-color: hsl(var(--border)); background: rgba(255,255,255,0.7); backdrop-filter: blur(8px); color: hsl(var(--muted-foreground));"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="6 9 12 15 18 9" />
      </svg>
    </button>
  </div>
</section>

<script>
  import { gsap, initHeroIntro } from "../../scripts/animations";

  const SPOTLIGHT_R = 260;
  const OFFSCREEN = -SPOTLIGHT_R * 4;

  const section = document.getElementById("inicio")!;
  const area = document.getElementById("hero-image-area")!;
  const reveal = document.getElementById("hero-reveal")!;
  const pattern = section.querySelector<SVGPatternElement>("#hgrid");
  const isTouch = window.matchMedia("(hover: none)").matches;

  // Entrada escalonada del hero (reemplaza animate-fade-up / animate-fade-in)
  initHeroIntro(section);

  document.getElementById("hero-scroll-btn")?.addEventListener("click", () => {
    document.getElementById("comunidad-section")?.scrollIntoView({ behavior: "smooth" });
  });

  const mouse = { x: OFFSCREEN, y: OFFSCREEN };
  const smooth = { x: OFFSCREEN, y: OFFSCREEN };
  const gridOff = { x: 0, y: 0 };

  if (!isTouch) {
    section.addEventListener("mousemove", (e) => {
      mouse.x = e.clientX;
      mouse.y = e.clientY;
    });
    section.addEventListener("mouseleave", () => {
      mouse.x = OFFSCREEN;
      mouse.y = OFFSCREEN;
    });
  }

  const setMask = (x: number, y: number) => {
    const mask = `radial-gradient(circle ${SPOTLIGHT_R}px at ${x}px ${y}px, rgba(255,255,255,1) 40%, rgba(255,255,255,0.75) 60%, rgba(255,255,255,0.4) 75%, rgba(255,255,255,0.12) 88%, transparent 100%)`;
    reveal.style.webkitMaskImage = mask;
    reveal.style.maskImage = mask;
  };

  // Bucle con gsap.ticker (reemplaza el requestAnimationFrame + canvas.toDataURL de React,
  // que generaba un data-URL nuevo en cada frame; la máscara radial-gradient es mucho más barata)
  gsap.ticker.add(() => {
    if (isTouch) {
      // Móvil: el spotlight se mueve con el progreso de scroll de la sección
      const rect = section.getBoundingClientRect();
      const progress = Math.max(0, Math.min(1, -rect.top / rect.height));
      const w = area.offsetWidth;
      const h = area.offsetHeight;
      // 1.6x comprime el barrido para que Pantera aparezca al ~30% del scroll
      const p = Math.min(progress * 1.6, 1);
      const spotX = -SPOTLIGHT_R + p * (w + SPOTLIGHT_R * 2);
      setMask(spotX, h * 0.38);
    } else {
      // Desktop: spotlight suavizado siguiendo el cursor
      smooth.x += (mouse.x - smooth.x) * 0.2;
      smooth.y += (mouse.y - smooth.y) * 0.2;

      const r = section.getBoundingClientRect();
      const cx = (smooth.x - r.left) / r.width - 0.5;
      const cy = (smooth.y - r.top) / r.height - 0.5;
      gridOff.x += (cx * 14 - gridOff.x) * 0.07;
      gridOff.y += (cy * 14 - gridOff.y) * 0.07;
      if (pattern) {
        pattern.setAttribute("x", String(gridOff.x));
        pattern.setAttribute("y", String(gridOff.y));
      }

      const areaRect = area.getBoundingClientRect();
      setMask(smooth.x - areaRect.left, smooth.y - areaRect.top);
    }
  });
</script>
