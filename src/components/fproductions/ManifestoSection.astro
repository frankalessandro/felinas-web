---
const pillars = [
  { k: "01", t: "Energía Felina", d: "Actitud, presencia y conexión con el público. Esa es la esencia que llevamos a cada escenario." },
  { k: "02", t: "Versatilidad escénica", d: "Shows, videoclips, activaciones, campañas digitales o eventos corporativos. Nos adaptamos al formato que tu proyecto necesita." },
  { k: "03", t: "Producción y experiencias", d: "Coreografía, imagen, puesta en escena y creatividad trabajadas en conjunto para ofrecer una experiencia completa." },
];
---

<section id="nosotras" class="relative py-24 md:py-36 bg-[#07030b] overflow-hidden">
  <!-- Glows: morado left + magenta right counter-balance -->
  <div class="absolute top-1/3 -left-20 w-[480px] h-[480px] rounded-full bg-felina-morado/18 blur-[110px]"></div>
  <div class="absolute bottom-0 right-0 w-[360px] h-[360px] rounded-full bg-[#ff006a]/10 blur-[100px]"></div>

  <!-- Ghost text — más grande, más crudo -->
  <div data-parallax-x="-140" class="absolute top-6 right-4 opacity-[0.05] pointer-events-none select-none">
    <h2 class="font-display font-black leading-[0.8] text-transparent" style="-webkit-text-stroke: 1.5px #ff006a; font-size: clamp(6rem, 16vw, 16rem);">
      WHO<br />WE ARE
    </h2>
  </div>

  <!-- Línea diagonal accent -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden">
    <div class="absolute bottom-[15%] -right-10 w-[110%] h-px bg-gradient-to-l from-transparent via-[#ff006a]/12 to-transparent" style="transform: rotate(-4deg)"></div>
  </div>

  <div class="container px-4 md:px-8 relative z-10">
    <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-start">
      <!-- Statement -->
      <div data-reveal class="lg:col-span-7">
        <p class="font-display font-semibold text-[#ff006a] text-xs tracking-[0.35em] uppercase mb-6 flex items-center gap-3">
          <span class="w-10 h-px bg-[#ff006a]"></span> Quiénes somos
        </p>
        <h2 class="font-display font-black text-4xl sm:text-5xl md:text-6xl leading-[0.95] tracking-tight mb-8">
          <span class="text-white">LA ENERGÍA</span>
          <span class="text-transparent" style="-webkit-text-stroke: 1.5px #ff006a;"> FELINA</span>
          <span class="text-white"> QUE TU EVENTO</span>
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-300 to-felina-morado italic"> NECESITA</span>
          <br /><br />
          <span class="text-white">NO SOLO</span>
          <span class="text-transparent" style="-webkit-text-stroke: 1.5px #ff006a;"> BAILAMOS.</span>
          <br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#ff006a] to-felina-morado italic">CREAMOS</span>
          <span class="text-white"> EXPERIENCIAS QUE</span>
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-300 to-felina-morado italic"> CONECTAN.</span>
        </h2>
        <p class="text-base md:text-lg text-white/70 leading-relaxed max-w-xl font-light">
          F Productions nació para transformar ideas en experiencias memorables. Somos un equipo de
          artistas que combina danza, presencia escénica y creatividad para adaptarse a cada proyecto.
          Desde un escenario hasta una campaña digital, nuestro propósito es generar momentos que conecten
          con el público y representen la esencia de cada marca o artista.
        </p>
      </div>

      <!-- Pillars -->
      <div data-reveal class="lg:col-span-5 flex flex-col gap-5">
        {pillars.map((p) => (
          <div
            data-scroll-active
            class="group relative rounded-none border-l-2 border-white/10 bg-white/[0.02] pl-6 pr-5 py-5 transition-all duration-300 hover:border-l-[#ff006a] data-[active=true]:border-l-[#ff006a] hover:bg-[#ff006a]/[0.04] data-[active=true]:bg-[#ff006a]/[0.04]"
          >
            <div class="flex items-start gap-5">
              <span class="font-display font-black text-3xl text-transparent shrink-0 transition-all duration-300" style="-webkit-text-stroke: 1px rgba(255,0,106,0.4);" >{p.k}</span>
              <div>
                <h3 class="font-display font-bold text-lg text-white mb-1.5">{p.t}</h3>
                <p class="text-sm text-white/65 leading-relaxed">{p.d}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
