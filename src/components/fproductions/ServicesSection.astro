---
const services = [
  {
    tag: "Lo más pedido",
    title: "Shows en vivo",
    desc: "Creamos momentos que combinan danza, energía y producción escénica para convertir cualquier evento en una experiencia memorable.",
    points: ["Discotecas & bares", "Aperturas y cierres", "Coreografías temáticas"],
    featured: true,
  },
  {
    tag: null,
    title: "Videos musicales",
    desc: "Acompañamos artistas y producciones audiovisuales con dirección de movimiento, interpretación y presencia frente a cámara para potenciar cada escena.",
    points: ["Videoclips", "Contenido audiovisual", "Dirección de movimiento"],
    featured: false,
  },
  {
    tag: null,
    title: "Animación de eventos",
    desc: "Acompañamos tu evento de principio a fin generando interacción, dinamismo y una experiencia que mantiene al público conectado en todo momento.",
    points: ["Animación", "Recibimiento", "Shows intermedios"],
    featured: false,
  },
  {
    tag: null,
    title: "Modelaje y potenciación de marcas",
    desc: "Representamos marcas, productos y campañas a través de imagen, presencia y creación de contenido, conectando de forma auténtica con el público y nuestra esencia.",
    points: ["Campañas TikTok / Reels", "Activaciones", "Lanzamientos"],
    featured: false,
  },
];
---

<section id="servicios" class="relative py-24 md:py-36 bg-[#07030b] border-t border-white/5 overflow-hidden">
  <div class="absolute bottom-0 right-1/4 w-[500px] h-[500px] rounded-full bg-[#ff006a]/10 blur-[130px] pointer-events-none"></div>
  <div class="absolute top-0 left-1/3 w-[300px] h-[300px] rounded-full bg-felina-morado/15 blur-[100px] pointer-events-none"></div>

  <div class="container px-4 md:px-8 relative z-10">
    <div data-reveal class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-14 md:mb-20">
      <div>
        <p class="font-display font-semibold text-[#ff006a] text-xs tracking-[0.35em] uppercase mb-5 flex items-center gap-3">
          <span class="w-10 h-px bg-[#ff006a]"></span> Qué hacemos
        </p>
        <h2 class="font-display font-black text-4xl md:text-6xl text-white tracking-tighter leading-none">
          LO QUE PODEMOS<br /><span class="text-transparent" style="-webkit-text-stroke: 1.5px #ff006a;">CREAR JUNTOS</span>
        </h2>
      </div>
      <p class="text-white/60 max-w-sm text-sm md:text-base leading-relaxed">
        Nos adaptamos a la esencia de tu proyecto para crear experiencias que conectan con tu público.
        Cuéntanos tu idea y diseñemos juntos la mejor forma de hacerla realidad.
      </p>
    </div>

    <div id="services-list" class="flex flex-col divide-y divide-white/8">
      {services.map((s) => (
        <div
          data-reveal
          data-spotlight-item
          class="group relative flex flex-col md:flex-row md:items-center gap-4 md:gap-0 py-8 md:py-10 cursor-default overflow-hidden transition-all duration-300"
        >
          <!-- flood layer -->
          <div class="absolute inset-0 bg-[#ff006a] translate-y-full group-hover:translate-y-0 group-data-[spot=true]:translate-y-0 transition-transform duration-500 ease-[cubic-bezier(0.76,0,0.24,1)] z-0"></div>

          <!-- Title -->
          <div class="relative z-10 flex-1 md:min-w-[280px]">
            <div class="flex items-center gap-3">
              <h3 class="font-display font-black text-2xl md:text-4xl pl-4 text-white group-hover:text-black group-data-[spot=true]:text-black tracking-tight transition-colors duration-300 leading-none">
                {s.title}
              </h3>
              {s.tag && (
                <span class="hidden md:inline-flex text-[9px] font-bold uppercase tracking-[0.2em] text-[#ff006a] group-hover:text-black group-data-[spot=true]:text-black group-hover:border-black/30 group-data-[spot=true]:border-black/30 bg-[#ff006a]/15 group-hover:bg-black/10 group-data-[spot=true]:bg-black/10 border border-[#ff006a]/30 px-3 py-1 transition-colors duration-300">
                  {s.tag}
                </span>
              )}
            </div>
          </div>

          <!-- Desc + tags -->
          <div class="relative z-10 flex-1 max-w-lg">
            <p class="text-sm md:text-base text-white/70 group-hover:text-black group-data-[spot=true]:text-black leading-relaxed mb-4 transition-colors duration-300">{s.desc}</p>
            <ul class="flex flex-wrap gap-2">
              {s.points.map((pt) => (
                <li class="text-[11px] font-semibold uppercase tracking-wide text-white/70 group-hover:text-black group-data-[spot=true]:text-black bg-white/5 group-hover:bg-black/10 group-data-[spot=true]:bg-black/10 border border-white/15 group-hover:border-black/25 group-data-[spot=true]:border-black/25 px-3 py-1 transition-colors duration-300">
                  {pt}
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
