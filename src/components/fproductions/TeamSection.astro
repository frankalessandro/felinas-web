---
import { Image } from "astro:assets";
import maeImg from "../../assets/fproductions/mae.webp";
import gabrielaImg from "../../assets/fproductions/gabriela.webp";
import andreaImg from "../../assets/fproductions/andrea.webp";
import isaImg from "../../assets/fproductions/isa.webp";
import saloImg from "../../assets/fproductions/salo.webp";
import sharyImg from "../../assets/fproductions/shary.webp";
import angieImg from "../../assets/fproductions/angie.webp";

const team = [
  { name: "Mae", role: "Directora", trait: "La alegre del equipo", img: maeImg },
  { name: "Andrea", role: "Integrante", trait: "La multifacética del equipo", img: andreaImg },
  { name: "Angie", role: "Integrante", trait: "La apasionada del equipo", img: angieImg },
  { name: "Gabby", role: "Integrante", trait: "La fashionista del equipo", img: gabrielaImg },
  { name: "Isa", role: "Integrante", trait: "La auténtica del equipo", img: isaImg },
  { name: "Salo", role: "Integrante", trait: "La enérgica del equipo", img: saloImg },
  { name: "Shary", role: "Integrante", trait: "La soñadora del equipo", img: sharyImg },
];
---

<section id="equipo" class="relative bg-[#07030b]">
  <div class="absolute top-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-[#ff006a]/25 to-transparent"></div>
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[70vw] h-56 bg-felina-morado/12 blur-[110px] pointer-events-none"></div>

  <div class="container px-4 md:px-8 relative z-10 pt-24 md:pt-36 pb-10 md:pb-14">
    <div data-reveal class="flex flex-col md:flex-row md:items-end justify-between gap-6">
      <div>
        <p class="font-display font-semibold text-[#ff006a] text-xs tracking-[0.35em] uppercase mb-5 flex items-center gap-3">
          <span class="w-10 h-px bg-[#ff006a]"></span> Quiénes hacen posible cada experiencia
        </p>
        <h2 class="font-display font-black text-4xl md:text-6xl text-white tracking-tighter leading-none">
          NUESTRO<br /><span class="text-felina-morado">EQUIPO</span>
        </h2>
      </div>
      <p class="text-white/60 max-w-sm text-sm md:text-base leading-relaxed">
        Detrás de cada proyecto hay personas apasionadas por lo que hacen. Cada integrante aporta su
        talento, personalidad y compromiso para crear experiencias auténticas y memorables.
      </p>
    </div>
  </div>

  <!-- Cartucho de revólver: pinneado, cada carta rota 3D para dar paso a la siguiente. Carta centrada, foto completa sin recortar. -->
  <div data-revolver class="relative h-screen w-full overflow-hidden flex items-center justify-center" style="perspective: 1600px;">
    <!-- Glow de fondo -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[80vw] h-[80vh] bg-felina-morado/10 rounded-full blur-[140px] pointer-events-none"></div>

    <!-- Aclara que el avance es por scroll vertical, no un carrusel swipeable -->
    <div
      data-revolver-hint
      class="absolute top-24 md:top-28 right-5 md:right-10 z-20 flex flex-col items-center gap-2 pointer-events-none"
    >
      <span class="text-white/45 text-[10px] font-semibold uppercase tracking-[0.3em]" style="writing-mode: vertical-rl;">
        Scroll
      </span>
      <div class="w-6 h-9 rounded-full border border-white/25 flex justify-center pt-1.5" data-ambient="bounce">
        <span class="w-1 h-1.5 rounded-full bg-white/60"></span>
      </div>
    </div>

    {team.map((member, i) => (
      <div
        data-revolver-card
        class="absolute inset-0 flex flex-col items-center justify-center gap-6 px-4"
        style="backface-visibility: hidden;"
      >
        <!-- Frame: la foto completa, sin recortar -->
        <div class="relative h-[58vh] md:h-[68vh] w-auto max-w-[90vw] rounded-2xl overflow-hidden bg-[#11081a] border border-white/10 shadow-[0_30px_80px_rgba(0,0,0,0.6)]">
          <Image
            src={member.img}
            alt={`${member.name} — F Productions`}
            class="h-full w-auto max-w-[90vw] object-contain"
            widths={[500, 800, 1100]}
            sizes="90vw"
            loading={i === 0 ? "eager" : "lazy"}
          />
        </div>

        <!-- Name -->
        <div class="relative z-10 text-center">
          <div class="w-14 h-1 bg-[#ff006a] mb-4 mx-auto"></div>
          <p class="font-display font-black text-white tracking-tighter leading-[0.85]" style="font-size: clamp(2.5rem, 7vw, 5rem);">
            {member.name}
          </p>
          <p class="flex items-center justify-center gap-3 mt-3 text-xs md:text-sm">
            <span class="text-[#ff006a] uppercase tracking-[0.3em] font-semibold">{member.role}</span>
            <span class="text-white/25">·</span>
            <span class="text-white/50 italic">{member.trait}</span>
          </p>
        </div>
      </div>
    ))}
  </div>
</section>
