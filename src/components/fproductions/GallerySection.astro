---
const BENTO = [
  { src: "https://images.unsplash.com/photo-1516450360452-9312f5e86fc7?q=80&w=1000&auto=format&fit=crop", tag: "Main stage", title: "Energía en vivo" },
  { src: "https://images.unsplash.com/photo-1504506894056-b8db25345719?q=80&w=900&auto=format&fit=crop", tag: null, title: null },
  { src: "https://images.unsplash.com/photo-1492684223066-81342ee5ff30?q=80&w=900&auto=format&fit=crop", tag: "Eventos", title: "Hora loca" },
  { src: "https://images.unsplash.com/photo-1543807535-eceef0bc6599?q=80&w=1000&auto=format&fit=crop", tag: null, title: null },
  { src: "https://images.unsplash.com/photo-1470229722913-7c0e2dbbafd3?q=80&w=1200&auto=format&fit=crop", tag: "Discotecas", title: "Noches que se cuentan" },
  { src: "https://images.unsplash.com/photo-1542282811-943ef1a6770f?q=80&w=900&auto=format&fit=crop", tag: null, title: null },
];
---

<section id="galeria" class="relative py-24 md:py-16 bg-[#07030b] overflow-hidden">
  <div class="container px-4 md:px-8 relative z-10 mb-10 md:mb-0">
    <div data-reveal class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-14 md:mb-16">
      <h2 class="font-display font-black text-4xl md:text-6xl text-white tracking-tighter leading-none">
        MOMENTOS<br /><span class="text-felina-morado">INOLVIDABLES</span>
      </h2>
      <p class="text-white/60 max-w-sm text-sm uppercase tracking-[0.15em] font-medium">
        Sigue bajando: la galería se mueve contigo. Shows en vivo, eventos y presentaciones estelares.
      </p>
    </div>
  </div>

  <!-- Filmstrip horizontal pinneado: el scroll vertical mueve la galería en X, centrado en pantalla -->
  <div data-horizontal-scroll class="relative h-screen w-full overflow-hidden">
    <div data-horizontal-track class="flex h-full items-center gap-4 md:gap-6 pl-4 md:pl-8 pr-[10vw] will-change-transform">
      {BENTO.map((item, i) => (
        <div
          class:list={[
            "group relative shrink-0 h-[48%] md:h-[58%] rounded-3xl overflow-hidden bg-[#11081a] cursor-pointer",
            i % 3 === 0 ? "w-[78vw] sm:w-[52vw] md:w-[38vw]" : "w-[62vw] sm:w-[38vw] md:w-[24vw]",
          ]}
        >
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/10 to-transparent z-20 transition-opacity duration-500 group-hover:opacity-60"></div>
          <div class="absolute inset-0 bg-gradient-to-tr from-[#ff006a]/60 via-transparent to-felina-morado/50 mix-blend-color z-10 opacity-100 group-hover:opacity-0 transition-opacity duration-700"></div>
          <img
            src={item.src}
            alt="Galería F Productions"
            loading="lazy"
            class="w-full h-full object-cover grayscale-[60%] scale-105 transition-all duration-700 ease-out group-hover:grayscale-0 group-hover:scale-125 group-hover:rotate-1"
          />
          <div class="absolute inset-0 border-2 border-[#ff006a]/0 group-hover:border-[#ff006a]/60 rounded-3xl transition-colors duration-500 z-20 pointer-events-none"></div>
          {item.tag && (
            <div class="absolute bottom-5 left-5 z-30 overflow-hidden">
              <p class="text-[10px] uppercase tracking-[0.25em] text-purple-300 font-bold mb-1 transition-transform duration-500 group-hover:-translate-y-1">{item.tag}</p>
              <p class="text-lg md:text-2xl font-display font-bold text-white transition-transform duration-500 group-hover:translate-x-2">{item.title}</p>
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
