---
import { Image } from "astro:assets";
import galeriaMae from "../../assets/fproductions/galeria-mae.webp";
import galeriaSalo from "../../assets/fproductions/galeria-salo.webp";
import galeriaAndrea from "../../assets/fproductions/galeria-andrea.webp";
import galeriaGabriela from "../../assets/fproductions/galeria-gabriela.webp";
import posterLoop3144 from "../../assets/fproductions/posters/loop-3144.webp";
import posterLoop3199 from "../../assets/fproductions/posters/loop-3199.webp";
import posterLoop3414 from "../../assets/fproductions/posters/loop-3414.webp";

type Tile = {
  /** Los `video` son clips mudos que corren solos mientras el tile está en pantalla. */
  kind: "image" | "video";
  src: ImageMetadata;
  /** Solo para kind === "video": nombre del mp4 en /videos. */
  file?: string;
  alt: string;
  tag: string | null;
  title: string | null;
};

/**
 * Los clips van intercalados entre las fotos, no agrupados: el movimiento
 * aparece de a poco a lo largo del filmstrip en vez de golpear todo junto.
 *
 * Las fotos van sin rótulo a propósito: hablan solas y el texto competía con
 * ellas. Los clips sí lo llevan, porque ahí el rótulo cumple otra función —
 * avisa que eso se mueve.
 */
const BENTO: Tile[] = [
  { kind: "image", src: galeriaMae, alt: "Mae en escena", tag: null, title: null },
  { kind: "video", src: posterLoop3144, file: "loop-3144", alt: "Coreografía de F Productions en movimiento", tag: "En movimiento", title: "Así se ve en vivo" },
  { kind: "image", src: galeriaSalo, alt: "Salo — F Productions", tag: null, title: null },
  { kind: "video", src: posterLoop3199, file: "loop-3199", alt: "Presentación de F Productions en movimiento", tag: "En movimiento", title: "Puesta en escena" },
  { kind: "image", src: galeriaAndrea, alt: "Andrea — F Productions", tag: null, title: null },
  { kind: "video", src: posterLoop3414, file: "loop-3414", alt: "Show de F Productions en movimiento", tag: "En movimiento", title: "Cada detalle cuenta" },
  { kind: "image", src: galeriaGabriela, alt: "Gabriela en discoteca", tag: null, title: null },
];
---

<section id="galeria" class="relative py-24 md:py-16 bg-[#07030b] overflow-hidden">
  <div class="container px-4 md:px-8 relative z-10 mb-10 md:mb-0">
    <div data-reveal class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-14 md:mb-16">
      <h2 class="font-display font-black text-4xl md:text-6xl text-white tracking-tighter leading-none">
        MOMENTOS<br /><span class="text-felina-morado">QUE HABLAN POR SÍ SOLOS.</span>
      </h2>
      <p class="text-white/60 max-w-sm text-sm md:text-base leading-relaxed">
        Cada imagen cuenta una historia. Así vivimos cada escenario, cada producción y cada experiencia
        que creamos junto a nuestros clientes.
      </p>
    </div>
  </div>

  <!-- Filmstrip horizontal pinneado: el scroll vertical mueve la galería en X, centrado en pantalla -->
  <div data-horizontal-scroll class="relative h-screen w-full overflow-hidden">
    <div data-horizontal-track class="flex h-full items-center gap-4 md:gap-6 pl-4 md:pl-8 pr-[10vw] will-change-transform">
      {BENTO.map((item, i) => (
        <div
          data-scroll-active
          {...(item.kind === "video" ? { "data-reel-loop": true, "data-playing": "false" } : {})}
          class:list={[
            "group relative shrink-0 h-[48%] md:h-[58%] rounded-3xl overflow-hidden bg-[#11081a] cursor-pointer",
            i % 3 === 0 ? "w-[78vw] sm:w-[52vw] md:w-[38vw]" : "w-[62vw] sm:w-[38vw] md:w-[24vw]",
          ]}
        >
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/10 to-transparent z-20 transition-opacity duration-500 group-hover:opacity-60 group-data-[active=true]:opacity-60"></div>
          <div class="absolute inset-0 bg-gradient-to-tr from-[#ff006a]/60 via-transparent to-felina-morado/50 mix-blend-color z-10 opacity-100 group-hover:opacity-0 group-data-[active=true]:opacity-0 transition-opacity duration-700"></div>
          <Image
            src={item.src}
            alt={item.alt}
            widths={[400, 700, 1000]}
            sizes="(max-width: 640px) 78vw, 38vw"
            loading={i < 2 ? "eager" : "lazy"}
            class="w-full h-full object-cover grayscale-[60%] scale-105 transition-all duration-700 ease-out group-hover:grayscale-0 group-data-[active=true]:grayscale-0 group-hover:scale-125 group-data-[active=true]:scale-125 group-hover:rotate-1 group-data-[active=true]:rotate-1 group-data-[playing=true]:opacity-0"
          />
          {item.kind === "video" && (
            <video
              data-src={`/videos/${item.file}.mp4`}
              poster={item.src.src}
              muted
              loop
              playsinline
              preload="none"
              class="absolute inset-0 w-full h-full object-cover opacity-0 transition-opacity duration-700 group-data-[playing=true]:opacity-100 grayscale-[60%] group-hover:grayscale-0 group-data-[active=true]:grayscale-0"
            />
          )}
          <div class="absolute inset-0 border-2 border-[#ff006a]/0 group-hover:border-[#ff006a]/60 group-data-[active=true]:border-[#ff006a]/60 rounded-3xl transition-colors duration-500 z-20 pointer-events-none"></div>
          {item.tag && (
            <div class="absolute bottom-5 left-5 z-30 overflow-hidden">
              <p class="text-[10px] uppercase tracking-[0.25em] text-purple-300 font-bold mb-1 transition-transform duration-500 group-hover:-translate-y-1 group-data-[active=true]:-translate-y-1">{item.tag}</p>
              <p class="text-lg md:text-2xl font-display font-bold text-white transition-transform duration-500 group-hover:translate-x-2 group-data-[active=true]:translate-x-2">{item.title}</p>
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
